@baseUrl = http://localhost:8080/api/v1

### Log in as admin (manages documents)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin-change-me"
}

### Log in as agent (analyses disputes)
# @name agentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "agent",
  "password": "agent-change-me"
}

### List documents
GET {{baseUrl}}/documents?page=0&size=20
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### Upload a rules document
POST {{baseUrl}}/documents
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="goods-not-received-v2.txt"
Content-Type: text/plain

< ./src/main/resources/seed/rules/goods-not-received.txt
--boundary
Content-Disposition: form-data; name="reasonCategory"

GOODS_NOT_RECEIVED
--boundary--

### Delete a document
DELETE {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### Analyse: parcel never arrived (expect GOODS_NOT_RECEIVED)
# @name analyse
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{agentLogin.response.body.accessToken}}
Content-Type: application/json

{
  "description": "Customer says the parcel never arrived. The delivery date was three weeks ago and the merchant has not replied to two emails."
}

### Analyse: charged twice (expect DUPLICATE_PROCESSING)
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{agentLogin.response.body.accessToken}}
Content-Type: application/json

{
  "description": "Customer paid once at the supermarket but was charged the same amount twice, two minutes apart."
}

### Analyse: unrelated complaint (expect 422)
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{agentLogin.response.body.accessToken}}
Content-Type: application/json

{
  "description": "Customer is unhappy that the bank branch closed early on Saturday."
}

### Analyse without a token (expect 401)
POST {{baseUrl}}/disputes/analyse
Content-Type: application/json

{
  "description": "Customer says the parcel never arrived."
}

### Analyse with the admin token (expect 403)
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "description": "Customer says the parcel never arrived."
}

### Analyse with an Idempotency-Key (run twice: the second call returns the same result with Idempotent-Replayed: true)
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{agentLogin.response.body.accessToken}}
Idempotency-Key: dispute-demo-0001
Content-Type: application/json

{
  "description": "Customer paid once at the supermarket but was charged the same amount twice, two minutes apart."
}

### Same Idempotency-Key with a different body (expect 409)
POST {{baseUrl}}/disputes/analyse
Authorization: Bearer {{agentLogin.response.body.accessToken}}
Idempotency-Key: dispute-demo-0001
Content-Type: application/json

{
  "description": "Customer says the jacket delivered is a different colour from the photo."
}

### Get a stored analysis
GET {{baseUrl}}/disputes/{{analyse.response.body.id}}
Authorization: Bearer {{agentLogin.response.body.accessToken}}
